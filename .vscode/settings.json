{
    "files.associations": {
        "ignore": "ignore"
    },
    "search.exclude": {
        "аrchive/": true,
    },
    // #region nix
    "nix.enableLanguageServer": true,
    "nix.serverPath": [
        "nixd",
        // "--inlay-hints=false",
        // "--semantic-tokens=true",
    ],
    // check https://github.com/nix-community/nixd/blob/main/nixd/docs/configuration.md for all nixd config
    "nix.serverSettings": {
        "nixd": {
            "nixpkgs": {
                "expr": "let inputs = (builtins.getFlake (''git+file://'' + toString ./.)).inputs; system = ''x86_64-linux''; in (import ''${toString ./.}/nixpkgs.nix'' { inherit system inputs; })",
            },
            "options": {
                "nixos": {
                    "expr": "(builtins.getFlake (''git+file://'' + toString ./.)).nixosConfigurations.xiaomi-A35S-laptop-nixos.options",
                },
                "home-manager": {
                    "expr": "(builtins.getFlake (''git+file://'' + toString ./.)).nixosConfigurations.xiaomi-A35S-laptop-nixos.options.home-manager.users.type.getSubOptions [] // (builtins.getFlake (''git+file://'' + toString ./.)).homeConfigurations.nixd.options",
                },
            },
        }
    },
    "[nix]": {
        "editor.formatOnSave": true,
        "editor.wordBasedSuggestions": "off",
    },
    "nix.hiddenLanguageServerErrors": [
        "textDocument/definition",
        "textDocument/formatting",
    ],
    "python.analysis.extraPaths": [
        "/etc/nixpkgs/nixos/lib/test-driver/src/",
    ],
    // #endregion nix
}
